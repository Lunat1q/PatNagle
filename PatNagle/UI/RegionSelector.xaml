<Window x:Class="PatNagle.UI.RegionSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PatNagle.UI"
        mc:Ignorable="d"
        WindowStyle="None"   
        WindowState="Maximized" AllowsTransparency="True" 
        Title="RegionSelector" Height="450" Width="800" Background="#3F00FF61" MouseDown="Window_MouseDown" MouseUp="Window_MouseUp" MouseMove="Region_MouseMove">
    <Canvas Name="Region" MouseMove="Region_MouseMove">
        <Rectangle Stroke="Red" Height="10" Width="10" StrokeThickness="5"/>
        
    </Canvas>
</Window>
